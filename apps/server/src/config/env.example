PORT=3010

# Bailian / DashScope
BAILIAN_API_KEY=
BAILIAN_ASR_MODEL=qwen3-asr-flash-filetrans
BAILIAN_REWRITE_MODEL=qwen3.7-max

MEDIACRAWLER_ENABLED=true
MEDIACRAWLER_ROOT=D:\path\to\MediaCrawler
MEDIACRAWLER_PYTHON=D:\path\to\python.exe
MEDIACRAWLER_LOGIN_TYPE=cookie
MEDIACRAWLER_COOKIES=
MEDIACRAWLER_HEADLESS=true

DOUYIN_COOKIE_BROWSER=edge
DOUYIN_COOKIES_FILE=

# Aliyun OSS
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PREFIX=duix/mvp

# Local services
LOCAL_TTS_BASE_URL=http://127.0.0.1:18180
LOCAL_AVATAR_BASE_URL=http://127.0.0.1:8383/easy
LOCAL_TTS_DATA_ROOT=D:\duix_avatar_data\voice\data
LOCAL_FACE2FACE_TEMP_ROOT=D:\duix_avatar_data\face2face\temp
LOCAL_AVATAR_POLL_INTERVAL_MS=3000
LOCAL_AVATAR_POLL_TIMEOUT_MS=1800000
